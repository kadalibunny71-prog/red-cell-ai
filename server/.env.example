# Server only — never copy this file into client/
NODE_ENV=development
PORT=8787
CLIENT_URL=http://localhost:5173

# Supabase project credentials (server only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Required only for automatic schema creation using Supabase Management API:
SUPABASE_ACCESS_TOKEN=your_sbp_management_token
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
AUTO_MIGRATE=false

# Session security (generate a long random value)
JWT_SECRET=replace_with_a_long_random_32_plus_character_secret
SESSION_DAYS=30

# Gemini — server only
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.8-flash
